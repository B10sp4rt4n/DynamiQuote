{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cotiza:recurring-services:preparation:0.1",
  "title": "Recurring services preparation contract",
  "description": "Planning fixtures only. Runtime must validate tenant access, effective dates, permissions, decimal bounds, overlaps, identities and approval fingerprints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "simulation_only",
    "effects",
    "agreements"
  ],
  "properties": {
    "schema_version": {
      "const": "cotiza.recurring.preparation.v0.1"
    },
    "simulation_only": {
      "const": true
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create_clients",
        "write_database",
        "stamp",
        "send_email",
        "charge"
      ],
      "properties": {
        "create_clients": {
          "const": false
        },
        "write_database": {
          "const": false
        },
        "stamp": {
          "const": false
        },
        "send_email": {
          "const": false
        },
        "charge": {
          "const": false
        }
      }
    },
    "agreements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_ref",
          "client_ref",
          "tenant_ref",
          "status",
          "terms_revision",
          "contract",
          "billing",
          "currency",
          "lines",
          "evidence_refs",
          "activation_approval_ref",
          "pending_fields"
        ],
        "properties": {
          "case_ref": {
            "type": "string",
            "minLength": 1
          },
          "client_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "tenant_ref": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "active",
              "paused",
              "ended"
            ]
          },
          "terms_revision": {
            "type": "integer",
            "minimum": 1
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "starts_on",
              "ends_on",
              "auto_renew",
              "notice_days"
            ],
            "properties": {
              "kind": {
                "enum": [
                  null,
                  "month_to_month",
                  "fixed_term"
                ]
              },
              "starts_on": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "ends_on": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "auto_renew": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "notice_days": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "billing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cadence",
              "basis",
              "anchor_day",
              "anchor_policy",
              "timezone",
              "effective_from",
              "due_days"
            ],
            "properties": {
              "cadence": {
                "enum": [
                  null,
                  "monthly",
                  "quarterly",
                  "annual"
                ]
              },
              "basis": {
                "enum": [
                  null,
                  "advance",
                  "arrears"
                ]
              },
              "anchor_day": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 31
              },
              "anchor_policy": {
                "const": "clamp_to_month_end_preserve_original_anchor"
              },
              "timezone": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "effective_from": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "due_days": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "currency": {
            "enum": [
              null,
              "MXN",
              "USD",
              "EUR"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line_id",
                "description",
                "sku",
                "quantity",
                "unit_price",
                "fiscal_classification_ref"
              ],
              "properties": {
                "line_id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "sku": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "quantity": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
                },
                "unit_price": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
                },
                "fiscal_classification_ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              }
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "activation_approval_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "pending_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "active",
                    "paused",
                    "ended"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "client_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "currency": {
                  "enum": [
                    "MXN",
                    "USD",
                    "EUR"
                  ]
                },
                "activation_approval_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "minItems": 1
                },
                "pending_fields": {
                  "maxItems": 0
                },
                "lines": {
                  "minItems": 1,
                  "items": {
                    "allOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "line_id",
                          "description",
                          "sku",
                          "quantity",
                          "unit_price",
                          "fiscal_classification_ref"
                        ],
                        "properties": {
                          "line_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": {
                            "type": "string",
                            "minLength": 1
                          },
                          "sku": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1
                          },
                          "quantity": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
                          },
                          "unit_price": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
                          },
                          "fiscal_classification_ref": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1
                          }
                        }
                      },
                      {
                        "properties": {
                          "quantity": {
                            "type": "string",
                            "pattern": "^(0*[1-9][0-9]*(\\.[0-9]{1,4})?|0\\.[0-9]*[1-9][0-9]*)$"
                          },
                          "unit_price": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
                          }
                        }
                      }
                    ]
                  }
                },
                "contract": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "month_to_month",
                        "fixed_term"
                      ]
                    },
                    "starts_on": {
                      "type": "string",
                      "format": "date"
                    },
                    "auto_renew": {
                      "type": "boolean"
                    },
                    "notice_days": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "billing": {
                  "properties": {
                    "cadence": {
                      "enum": [
                        "monthly",
                        "quarterly",
                        "annual"
                      ]
                    },
                    "basis": {
                      "enum": [
                        "advance",
                        "arrears"
                      ]
                    },
                    "anchor_day": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 31
                    },
                    "timezone": {
                      "type": "string",
                      "minLength": 1
                    },
                    "effective_from": {
                      "type": "string",
                      "format": "date"
                    },
                    "due_days": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "active",
                    "paused",
                    "ended"
                  ]
                },
                "contract": {
                  "properties": {
                    "kind": {
                      "const": "fixed_term"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "contract": {
                  "properties": {
                    "ends_on": {
                      "type": "string",
                      "format": "date"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
