# Piloto premium: apagado hasta completar esquema, revisión y registro real.
COTIZA_APPROVAL_ENABLED=false
# Tenant existente de SynAppsSys, verificado por lectura; slug interno: sys.
COTIZA_APPROVAL_TENANT_ID=389b6cc1-2f8d-4fe4-bc3d-f50f92df3157
# Deben coincidir con el despliegue estable y la instancia Clerk usada por ese despliegue.
COTIZA_APPROVAL_ORIGIN=https://cotiza.example.test
COTIZA_APPROVAL_ISSUER=https://clerk.example.test
# true: rechaza todas las credenciales multiDevice, aun si BS=0.
COTIZA_APPROVAL_SINGLE_DEVICE=true
# Facultades permanentes del piloto. IDs Clerk exactos, revisados fuera de la reconciliación legacy.
# La lista de managers debe ser un subconjunto de los aprobadores.
COTIZA_APPROVAL_APPROVER_USER_IDS=
COTIZA_APPROVAL_MANAGER_USER_IDS=
# Completar temporalmente con un ID Clerk ya vinculado y revisado en app_users.
COTIZA_APPROVAL_BOOTSTRAP_USER_IDS=
# Generar un valor aleatorio de al menos 32 caracteres fuera del repositorio.
COTIZA_APPROVAL_BOOTSTRAP_TICKET=
# UTC ISO-8601: ventana corta, nunca más de 24 horas hacia el futuro.
COTIZA_APPROVAL_BOOTSTRAP_UNTIL=
# Sólo para la herramienta administrativa de preparación; no lo consume el navegador.
COTIZA_APPROVAL_SETUP_ACTOR=
